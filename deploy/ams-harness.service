[Unit]
Description=ams harness: rootless supervisor for agent-managed services
After=network-online.target
Wants=network-online.target
# Backoff for a crash-looping harness lives here, not in the harness itself.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=harness
Group=harness
WorkingDirectory=/home/harness/ams
Environment=HOME=/home/harness
Environment=AMS_STATE_DIR=/home/harness/store/state
Environment=AMS_STORE_DIR=/home/harness/store
Environment=PYTHONPATH=/home/harness/ams/src
Environment=PATH=/home/harness/venv/bin:/home/harness/.local/bin:/usr/local/bin:/usr/bin:/bin
# Interpreter path must match deploy/apparmor/ams-harness attachment glob.
# --policy platform: cause dedupe and the Caddy rules (ams.platform.policy).
# Without it Caddy's start-up WARNINGs escalate on every start and a crash loop
# escalates per line. A host without the platform layer drops the flag.
ExecStart=/home/harness/venv/bin/python3 -m ams run --policy platform
# `systemctl reload ams-harness` rescans services/*/service.toml and adds,
# removes or restarts only what changed (ams.reload). This exists so a
# declaration change no longer needs a unit restart, which KillMode=control-group
# turns into an outage for every service. Equivalent: `ams ctl reload`.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
# Harness creates one child cgroup per service and writes memory.max / cpu.max / pids.max itself.
Delegate=yes
DelegateSubgroup=harness
# Services are direct children; a harness restart takes them all down (accepted trade-off).
KillMode=control-group
# Must stay above ams.cli.SHUTDOWN_BUDGET_S (45s) + ~1.5s of supervisor drain.
# The harness clamps the graceful phase to that budget, so a declaration with a
# large stop.timeout_s is capped rather than letting systemd SIGKILL us mid-stop.
# 45s is core mode's stop.timeout_s (40s, upstream core.service) plus margin.
# Raise both together if services ever need longer than 45s to stop.
TimeoutStopSec=50
# Do NOT set NoNewPrivileges=yes or an empty CapabilityBoundingSet= here: the
# harness relies on the setuid newuidmap/newgidmap helpers, which need to regain
# CAP_SETUID/CAP_SETGID on exec to write the per-service uid/gid maps.
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
