# locationservice — service on subdomain location (location.lishuyu.app)
location.lishuyu.app {
	log {
		format json
	}
	header X-Frame-Options "DENY"
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: https://unpkg.com https://tile.openstreetmap.org; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "strict-origin-when-cross-origin"
	reverse_proxy 127.0.0.1:9210
}
