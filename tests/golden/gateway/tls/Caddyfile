# Rendered from <state>/platform/mounts/*.json plus the live port
# allocation; `ams ctl restart caddy` applies it.
{
	admin off
	persist_config off
}

# Entry site: path-mounted services, plus the harness health probe.
api.lishuyu.app {
	log {
		format json
	}

	encode gzip zstd

	# Harness health probe (ams.health.check_http). Answers before any
	# import, so a gateway with zero mounts is still observably up.
	handle /ams-health {
		respond "ok" 200
	}

	# CORS for first-party SPAs that talk to the entry host cross-origin.
	# Add new SPA origins to ENTRY_CORS_ORIGIN_RE.
	@cors_preflight {
		method OPTIONS
		header_regexp Origin "^https://(readme\.lishuyu\.app|files?\.lishuyu\.app|blog\.lishuyu\.app|admin\.lishuyu\.app|llm\.lishuyu\.app|shuyuli\.com)$"
	}
	handle @cors_preflight {
		header Access-Control-Allow-Origin "{http.request.header.origin}"
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "Authorization, Content-Type, X-Claim-Token, X-File-Password"
		header Access-Control-Allow-Credentials "true"
		header Access-Control-Max-Age "86400"
		header Vary "Origin"
		respond 204
	}

	@cors_origin header_regexp Origin "^https://(readme\.lishuyu\.app|files?\.lishuyu\.app|blog\.lishuyu\.app|admin\.lishuyu\.app|llm\.lishuyu\.app|shuyuli\.com)$"
	header @cors_origin Access-Control-Allow-Origin "{http.request.header.origin}"
	header @cors_origin Access-Control-Allow-Credentials "true"
	header @cors_origin Vary "Origin"

	handle / {
		respond "lishuyu platform — see /<service>" 200
	}

	# pages management API on the entry host: the admin SPA's
	# `.lishuyu.app`-scoped cookie never rides cross-site to the service's
	# own subdomain. ONLY /pages/api/* is proxied here.
	handle /pages/api/* {
		uri strip_prefix /pages
		reverse_proxy 127.0.0.1:9216
	}

	# Path-mounted services (one import per mount, never a glob:
	# a stale file can then never be picked up silently).
	import sites/files.caddy
	import sites/timeservice.caddy

	handle {
		header Content-Type application/json
		respond `{"error":"not_found","detail":"no such service"}` 404
	}
}

# Subdomain sites (whole site blocks, imported at root scope).
import sites/displayservice.caddy
import sites/locationservice.caddy
import sites/pages.caddy
