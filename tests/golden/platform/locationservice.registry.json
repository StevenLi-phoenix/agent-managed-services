{
  "version": 1,
  "id": "locationservice",
  "audience": "locationservice",
  "display_name": "Location Service",
  "owner": "lishuyu",
  "capabilities": [
    "location",
    "gps",
    "tracking"
  ],
  "health_path": "/health",
  "acl": [
    {
      "action": "read",
