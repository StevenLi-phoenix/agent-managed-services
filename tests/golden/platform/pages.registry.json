{
  "version": 1,
  "id": "pages",
  "audience": "pages",
  "display_name": "Pages",
  "owner": "steven",
  "capabilities": [
    "pagehosting",
    "statichosting"
  ],
  "health_path": "/health",
  "acl": [
    {
      "action": "read",
      "principal": "anon",
